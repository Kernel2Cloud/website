---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Kernel2Cloud" description="This page doesn't exist. Head back to the Kernel2Cloud home page or the blog." noindex>
  <section class="notfound">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>Page not found</h1>
      <p>That page isn't here. It may have moved.</p>
      <a href="/" class="btn">Back to home <span class="arrow">→</span></a>
      <a href="/blog/" class="btn btn-line">Read the blog</a>
    </div>
  </section>
</Base>
